# Copy to .env and fill in — NEVER commit .env (it is gitignored).
# No secrets are committed in this repo. Ever.

# Server
PORT=3000
HOST=0.0.0.0
AGENT_NAME=muse

# HMAC shared secret provisioned by the Agent Games platform (per-agent).
# 32-byte random, shown ONCE at registration/rotation. The server rejects
# every request that lacks a valid x-agent-games-signature for this secret.
# Header is x-agent-games-signature (inbound AND outbound), HMAC-SHA256 hex
# over the RAW body. See SPEC.md — do not rename this variable.
AGENT_GAMES_HMAC_SECRET=
HMAC_HEADER=x-agent-games-signature
HMAC_ALGORITHM=sha256

# Kurier (proof submission to zkVerify, recommended). Get the key from zkVerify;
# see README.md. Leave empty to run with local-only proofs (proof_tx: null).
KURIER_API_URL=https://api.kurier.xyz
KURIER_API_KEY=

# Groth16 proving (official platform artifacts in circuits/artifacts/).
# These vkHashes are PUBLIC platform constants (from /api/circuit-info).
PLATFORM_VK_HASH_GATEKEEPER=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
PLATFORM_VK_HASH_VFYPOLICY=0x6c56509f1c56fd1fd4e9737f906d2220f4b95f1d507f1adf6899085bd74be047
CIRCUIT_DIR=./circuits/artifacts

# Steal the VFY committed policy (hash of the policy the agent registered with).
# Until the platform's commitment format is confirmed, this stays empty and the
# server commits to its local policy hash (see src/steal.ts).
STRATEGY_COMMITMENT=
